{
  "name": "molt-parakeet",
  "version": "0.2.0",
  "description": "Voice input for Molt Code: on-device speech-to-text with NVIDIA Parakeet TDT 0.6B v3 on sherpa-onnx, served to the composer through Molt's stt provider API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moltcode/molt-parakeet"
  },
  "files": [
    "bin",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "molt": {
    "manifestVersion": 1,
    "displayName": "Voice input (Parakeet)",
    "kinds": ["voice", "cli"],
    "platforms": ["darwin-arm64", "darwin-x64", "linux-x64", "linux-arm64"],
    "upstream": {
      "sherpa-onnx": "1.13.8",
      "model": "nemo-parakeet-tdt-0.6b-v3-int8"
    },
    "assets": ["parakeet-v3"],
    "contributes": {
      "bin": {
        "molt-parakeet": "bin/molt-parakeet"
      },
      "services": {
        "stt": {
          "name": "Parakeet speech-to-text",
          "command": "bin/molt-parakeet",
          "args": ["serve", "--socket", "${state}/stt.sock", "--model", "${asset:parakeet-v3}/model", "--idle-unload", "120"],
          "activation": "onDemand",
          "idleTimeout": 300,
          "env": {
            "MOLT_PARAKEET_PARENT_LIVENESS_STDIN": "1"
          },
          "socket": "${state}/stt.sock"
        }
      },
      "providers": {
        "parakeet-v3": {
          "kind": "stt",
          "name": "Parakeet TDT 0.6B v3",
          "service": "stt",
          "sampleRate": 16000,
          "streaming": false,
          "languages": ["bg", "hr", "cs", "da", "nl", "en", "et", "fi", "fr", "de", "el", "hu", "it", "lv", "lt", "mt", "pl", "pt", "ro", "sk", "sl", "es", "sv", "ru", "uk"]
        }
      }
    }
  }
}
